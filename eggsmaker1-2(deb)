#!/bin/bash
# ==============================================================================
# Script: eggsmaker
# Versión: 1.2.0
# Descripción: Suite integrada para administración de Penguins Eggs y Paquetes
#              Soporte multi-distro nativo: Arch (pacman/yay) y Debian/Ubuntu (apt)
# ==============================================================================

set -euo pipefail

VERSION="1.2.0"

# ------------------------------------------------------------------------------
# Detección de Distribución y Gestor de Paquetes
# ------------------------------------------------------------------------------
DISTRO_FAMILY="unknown"

if [ -f /etc/os-release ]; then
  # shellcheck disable=SC1091
  source /etc/os-release
  OS_CHECK="${ID_LIKE:-$ID}"
  if [[ "$OS_CHECK" =~ (arch|cachyos|endeavouros|manjaro) ]]; then
    DISTRO_FAMILY="arch"
  elif [[ "$OS_CHECK" =~ (debian|ubuntu|mint|pop|biglinux) ]]; then
    DISTRO_FAMILY="debian"
  fi
fi

# Fallback por presencia de ejecutables si os-release no es concluyente
if [ "$DISTRO_FAMILY" = "unknown" ]; then
  if command -v pacman &>/dev/null; then
    DISTRO_FAMILY="arch"
  elif command -v apt-get &>/dev/null; then
    DISTRO_FAMILY="debian"
  fi
fi

# ------------------------------------------------------------------------------
# Verificación e Instalación Automática de Dependencias
# ------------------------------------------------------------------------------
asegurar_dependencias() {
  local deps_faltantes=()
  local herramientas=("yad" "rsync" "grep" "sort" "wc")

  for cmd in "${herramientas[@]}"; do
    if ! command -v "$cmd" &>/dev/null; then
      deps_faltantes+=("$cmd")
    fi
  done

  if [ ${#deps_faltantes[@]} -gt 0 ]; then
    echo "Instalando dependencias necesarias: ${deps_faltantes[*]}..."

    if [ "$DISTRO_FAMILY" = "arch" ]; then
      pacman -Sy --needed --noconfirm "${deps_faltantes[@]}"
    elif [ "$DISTRO_FAMILY" = "debian" ]; then
      apt-get update && apt-get install -y "${deps_faltantes[@]}"
    elif command -v dnf &>/dev/null; then
      dnf install -y "${deps_faltantes[@]}"
    elif command -v zypper &>/dev/null; then
      zypper install -y "${deps_faltantes[@]}"
    else
      echo "Error: No se encontró un gestor de paquetes compatible para instalar: ${deps_faltantes[*]}"
      exit 1
    fi
  fi
}

asegurar_dependencias

# ------------------------------------------------------------------------------
# Detección del Usuario Real (cuando se ejecuta con sudo/pkexec)
# ------------------------------------------------------------------------------
REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(eval echo "~$REAL_USER")
HOST_NAME=$(hostname)

# Carpeta de trabajo: /home/usuario/hostname-pak
TARGET_DIR="$REAL_HOME/${HOST_NAME}-pak"
mkdir -p "$TARGET_DIR"
chown -R "$REAL_USER:" "$TARGET_DIR" 2>/dev/null || true

# Ruta del icono del sistema / personalizado
ICON_PATH="/usr/share/pixmaps/eggsmaker.png"
if [ ! -f "$ICON_PATH" ]; then
  ICON_PATH="system-software-install"
fi

# Rutas de archivos dentro de la carpeta hostname-pak
LOG_FILE="$TARGET_DIR/script.log"

NATIVE_LIST="$TARGET_DIR/lista-nativo.txt"
AUR_LIST="$TARGET_DIR/lista-aur.txt"
FLATPAK_LIST="$TARGET_DIR/lista-flatpak.txt"

NATIVE_SEL="$TARGET_DIR/nativo_selected.txt"
AUR_SEL="$TARGET_DIR/aur_selected.txt"
FLATPAK_SEL="$TARGET_DIR/flatpak_selected.txt"

NATIVE_RM_SEL="$TARGET_DIR/nativo_remove.txt"
AUR_RM_SEL="$TARGET_DIR/aur_remove.txt"
FLATPAK_RM_SEL="$TARGET_DIR/flatpak_remove.txt"

# ------------------------------------------------------------------------------
# Ejecución en YAD (Visor de salida puro en ventana YAD)
# ------------------------------------------------------------------------------
run_in_yad() {
  local cmd_to_run="$1"
  local title="${2:-Ejecutando proceso...}"

  bash -c "$cmd_to_run" 2>&1 | yad --text-info \
    --window-icon="$ICON_PATH" \
    --title="$title" \
    --width=800 --height=500 \
    --tail \
    --button="Cerrar:0" 2>/dev/null || true
}

run_as_user() {
  local user_cmd="$1"
  if [ -n "${SUDO_USER:-}" ]; then
    sudo -u "$REAL_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$REAL_USER")/bus" DISPLAY="${DISPLAY:-:0}" XAUTHORITY="${XAUTHORITY:-$REAL_HOME/.Xauthority}" bash -c "$user_cmd"
  else
    bash -c "$user_cmd"
  fi
}

export -f run_as_user

