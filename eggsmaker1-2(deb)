fi

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

# ------------------------------------------------------------------------------
# MÓDULO 1: Generador de Imágenes ISO
# ------------------------------------------------------------------------------
run_script_1() {
  DST="/etc/penguins-eggs.d/scripts/trust-desktop.sh"
  mkdir -p "$(dirname "$DST")"
  cat << 'EOF' > "$DST"
#!/bin/bash
set -euo pipefail

LAUNCHER_SYS="/usr/share/applications/install-system.desktop"
if [ -f "$LAUNCHER_SYS" ]; then
  chmod +x "$LAUNCHER_SYS"
fi

for desktop_dir in /home/*/[D|d]esktop /root/[D|d]esktop; do
  if [ -d "$desktop_dir" ]; then
    TARGET_LAUNCHER="$desktop_dir/install-system.desktop"

    if [ ! -f "$TARGET_LAUNCHER" ] && [ -f "$LAUNCHER_SYS" ]; then
      cp "$LAUNCHER_SYS" "$TARGET_LAUNCHER"
    fi

    if [ -f "$TARGET_LAUNCHER" ]; then
      chmod +x "$TARGET_LAUNCHER"

      if command -v gio >/dev/null 2>&1; then
        gio set "$TARGET_LAUNCHER" metadata::trusted yes 2>/dev/null || true
        if command -v sha256sum >/dev/null 2>&1; then
          gio set "$TARGET_LAUNCHER" metadata::xfce-exe-checksum "$(sha256sum "$TARGET_LAUNCHER" | awk '{print $1}')" 2>/dev/null || true
        fi
      fi
    fi
  fi
done

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f /usr/share/icons/* >/dev/null 2>&1 || true
fi
EOF
  chmod +x "$DST"

  ISO_DIR="/home/eggs"

  if yad --window-icon="$ICON_PATH" --image="dialog-question" --title="$S1_TITLE" --text="$S1_CONF_CFG" --button="Sí:0" --button="No:1" 2>/dev/null; then
    run_in_yad "eggs config" "$S1_TITLE - Configuración"
  fi

  DO_CLONE=0
  if yad --window-icon="$ICON_PATH" --image="dialog-question" --title="$S1_TITLE" --text="$S1_CONF_CLONE" --button="Sí:0" --button="No:1" 2>/dev/null; then
    DO_CLONE=1
  fi

  if [[ $DO_CLONE -eq 1 ]]; then
    run_in_yad "eggs kill && eggs tools clean && eggs remaster --clone" "$S1_TITLE - Creando Clon ISO"
  else
    run_in_yad "eggs kill && eggs tools clean && eggs remaster" "$S1_TITLE - Creando ISO"
  fi

  ISO_FILE=$(ls -t "$ISO_DIR"/*.iso 2>/dev/null | head -n 1 || true)

  while true; do
    DESTINO=$(yad --window-icon="$ICON_PATH" --file --directory --title="$S1_DEST_TITLE" 2>/dev/null || true)

    if [[ -z "$DESTINO" ]]; then
      if yad --window-icon="$ICON_PATH" --image="dialog-warning" --title="$S1_TITLE" --text="$S1_COPY_OMIT" --button="Sí:0" --button="No:1" 2>/dev/null; then
        break
      else
        continue
      fi
    fi

    if [[ -n "$ISO_FILE" ]]; then
      FILENAME=$(basename "$ISO_FILE")
      run_in_yad "
        echo 'Copiando archivo: $FILENAME'
        echo 'Destino: $DESTINO'
        echo '---------------------------------------------------'
        rsync --info=progress2 -h '$ISO_FILE' '$DESTINO/'
        echo '✔ Copia completada.'
      " "$S1_TITLE - Copiando ISO"
    else
      run_in_yad "
        echo 'Copiando contenido de: $ISO_DIR/'
        echo 'Destino: $DESTINO/'
        echo '---------------------------------------------------'
        rsync --info=progress2 -ah '$ISO_DIR/' '$DESTINO/'
        echo '✔ Copia completada.'
      " "$S1_TITLE - Copiando ISO"
    fi

    if ! yad --window-icon="$ICON_PATH" --image="dialog-question" --title="$S1_TITLE" --text="$S1_COPY_AGAIN" --button="Sí:0" --button="No:1" 2>/dev/null; then
      break
    fi
  done

  if yad --window-icon="$ICON_PATH" --image="dialog-question" --title="$S1_TITLE" --text="$S1_CONF_KILL" --button="Sí:0" --button="No:1" 2>/dev/null; then
    eggs kill 2>/dev/null || true
  fi

  yad --window-icon="$ICON_PATH" --title="$S1_TITLE" --image="dialog-information" --text="$S1_FINISH" --button="Aceptar:0" 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# MÓDULO 2: Instalador Live (Calamares / Krill)
# ------------------------------------------------------------------------------
run_script_2() {
  INSTALLER=$(yad --window-icon="$ICON_PATH" --list --radiolist --title="$S2_TITLE" --text="$S2_PROMPT" \
    --column="Sel" --column="Opción" --column="Comando" \
    TRUE "Calamares (GUI)" "eggs sysinstall calamares" \
    FALSE "Krill (TUI)" "eggs sysinstall krill" \
    --height=220 --width=480 --print-column=2 2>/dev/null || true)

  if [[ -n "$INSTALLER" ]]; then
    if [[ "$INSTALLER" =~ "Calamares" ]]; then
      eggs sysinstall calamares 2>/dev/null || true
    elif [[ "$INSTALLER" =~ "Krill" ]]; then
      run_in_yad "eggs sysinstall krill" "$S2_TITLE - Krill"
    fi
  fi
}

# ------------------------------------------------------------------------------
# MÓDULO 3: Gestor Unificado de Paquetes (Multi-Distro)
# ------------------------------------------------------------------------------
recopilar_listas() {
  log_msg "Generando listas de paquetes en: $TARGET_DIR (Distro: $DISTRO_FAMILY)"
  rm -f "$NATIVE_LIST" "$AUR_LIST" "$FLATPAK_LIST"

  if [ "$DISTRO_FAMILY" = "arch" ]; then
    pacman -Qqetn | sort | grep -vwE '^(base|base-devel)$' > "$NATIVE_LIST" || true
    if command -v yay &>/dev/null; then
      pacman -Qqetm | sort > "$AUR_LIST" || true
    fi
  elif [ "$DISTRO_FAMILY" = "debian" ]; then
    if command -v apt-mark &>/dev/null; then
      apt-mark showmanual | sort > "$NATIVE_LIST" || true
    else
      dpkg-query -f '${binary:Package}\n' -W | sort > "$NATIVE_LIST" || true
    fi
  fi

  if command -v flatpak &>/dev/null; then
    run_as_user "flatpak list --app --columns=application" > "$FLATPAK_LIST" 2>/dev/null || true
  fi

  chown -R "$REAL_USER:" "$TARGET_DIR" 2>/dev/null || true

  nat_cnt=$(wc -l < "$NATIVE_LIST" 2>/dev/null || echo 0)
  aur_cnt=$(wc -l < "$AUR_LIST" 2>/dev/null || echo 0)
  fl_cnt=$(wc -l < "$FLATPAK_LIST" 2>/dev/null || echo 0)

  log_msg "Nativos ($DISTRO_FAMILY): $nat_cnt | AUR: $aur_cnt | Flatpak: $fl_cnt"

  local info_text="Listas guardadas en:\n<b>$TARGET_DIR</b>\n\nSistema: <b>$DISTRO_FAMILY</b>\nPaquetes Nativos: $nat_cnt"
  if [ "$DISTRO_FAMILY" = "arch" ]; then
    info_text+="\nYay (AUR): $aur_cnt"
  fi
  info_text+="\nFlatpak: $fl_cnt"

  yad --window-icon="$ICON_PATH" --title="$S3_TITLE" \
    --image="dialog-information" \
    --text="$info_text" \
    --button="Aceptar:0" 2>/dev/null || true
}

selector_paquetes() {
  local titulo="$1" lista="$2" sel_prev="$3" tipo="$4"
  [[ -s "$lista" ]] || return 0

  local -a opciones=()
  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    local checked="FALSE"
    [[ -f "$sel_prev" ]] && grep -qxF "$pkg" "$sel_prev" && checked="TRUE"
    opciones+=("$checked" "$pkg" "$tipo")
  done < "$lista"

  local seleccion
  seleccion=$(yad --window-icon="$ICON_PATH" --list --checklist --title="$titulo" \
    --width=800 --height=500 --center \
    --column="CHK" --column="Paquete" --column="Tipo" \
    "${opciones[@]}" --print-column=2 --separator=$'\n' 2>/dev/null || true)

  if [[ -n "$seleccion" ]]; then
    echo "$seleccion" > "$sel_prev"
    chown "$REAL_USER:" "$sel_prev" 2>/dev/null || true
  fi
}

instalar_paquetes() {
  log_msg "Iniciando instalación desde $TARGET_DIR"
  local cmd_chain=""

  if [[ -s "$NATIVE_SEL" ]]; then
    local pkgs_native
    pkgs_native=$(tr '\n' ' ' < "$NATIVE_SEL")
    if [[ -n "$pkgs_native" ]]; then
      if [ "$DISTRO_FAMILY" = "arch" ]; then
        cmd_chain+="echo '=== INSTALANDO PAQUETES PACMAN ==='; pacman -S --needed --noconfirm $pkgs_native || true; "
      elif [ "$DISTRO_FAMILY" = "debian" ]; then
        cmd_chain+="echo '=== INSTALANDO PAQUETES APT ==='; apt-get update && apt-get install -y $pkgs_native || true; "
      fi
    fi
  fi

  if [ "$DISTRO_FAMILY" = "arch" ] && [[ -s "$AUR_SEL" ]] && command -v yay &>/dev/null; then
    local pkgs_yay
    pkgs_yay=$(tr '\n' ' ' < "$AUR_SEL")
    if [[ -n "$pkgs_yay" ]]; then
      cmd_chain+="echo '=== INSTALANDO PAQUETES YAY (AUR) ==='; sudo -u $REAL_USER DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$(id -u $REAL_USER)/bus yay -S --needed --noconfirm $pkgs_yay || true; "
    fi
  fi

  if [[ -s "$FLATPAK_SEL" ]] && command -v flatpak &>/dev/null; then
    local pkgs_flatpak
    pkgs_flatpak=$(tr '\n' ' ' < "$FLATPAK_SEL")
    if [[ -n "$pkgs_flatpak" ]]; then
      cmd_chain+="echo '=== INSTALANDO FLATPAKS ==='; sudo -u $REAL_USER DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$(id -u $REAL_USER)/bus flatpak install -y $pkgs_flatpak || true; "
    fi
  fi

  if [[ -n "$cmd_chain" ]]; then
    run_in_yad "$cmd_chain" "$S3_TITLE - Instalación"
  else
    yad --window-icon="$ICON_PATH" --title="$S3_TITLE" --image="dialog-warning" \
      --text="No hay paquetes seleccionados para instalar." \
      --button="Aceptar:0" 2>/dev/null || true
    return
  fi

  log_msg "Instalación completada"
  yad --window-icon="$ICON_PATH" --title="$S3_TITLE" --image="dialog-information" \
    --text="Proceso de instalación finalizado.\nConsulte $LOG_FILE para detalles." \
    --button="Aceptar:0" 2>/dev/null || true
}

desinstalar_paquetes() {
  log_msg "Iniciando desinstalación desde $TARGET_DIR"
  local cmd_chain=""

  if [[ -s "$NATIVE_RM_SEL" ]]; then
    local pkgs_native
    pkgs_native=$(tr '\n' ' ' < "$NATIVE_RM_SEL")
    if [[ -n "$pkgs_native" ]]; then
      if [ "$DISTRO_FAMILY" = "arch" ]; then
        cmd_chain+="echo '=== DESINSTALANDO PAQUETES PACMAN ==='; pacman -Rns --noconfirm $pkgs_native || true; "
      elif [ "$DISTRO_FAMILY" = "debian" ]; then
        cmd_chain+="echo '=== DESINSTALANDO PAQUETES APT ==='; apt-get purge -y $pkgs_native || true; "
      fi
    fi
  fi

  if [ "$DISTRO_FAMILY" = "arch" ] && [[ -s "$AUR_RM_SEL" ]] && command -v yay &>/dev/null; then
    local pkgs_yay
    pkgs_yay=$(tr '\n' ' ' < "$AUR_RM_SEL")
    if [[ -n "$pkgs_yay" ]]; then
      cmd_chain+="echo '=== DESINSTALANDO PAQUETES YAY (AUR) ==='; sudo -u $REAL_USER DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$(id -u $REAL_USER)/bus yay -Rns --noconfirm $pkgs_yay || true; "
    fi
  fi

  if [[ -s "$FLATPAK_RM_SEL" ]] && command -v flatpak &>/dev/null; then
    local pkgs_flatpak
    pkgs_flatpak=$(tr '\n' ' ' < "$FLATPAK_RM_SEL")
    if [[ -n "$pkgs_flatpak" ]]; then
      cmd_chain+="echo '=== DESINSTALANDO FLATPAKS ==='; sudo -u $REAL_USER DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$(id -u $REAL_USER)/bus flatpak uninstall -y $pkgs_flatpak || true; "
    fi
  fi

  if [[ -n "$cmd_chain" ]]; then
    run_in_yad "$cmd_chain" "$S3_TITLE - Desinstalación"
  else
    yad --window-icon="$ICON_PATH" --title="$S3_TITLE" --image="dialog-warning" \
      --text="No hay paquetes seleccionados para desinstalar." \
      --button="Aceptar:0" 2>/dev/null || true
    return
  fi

  log_msg "Desinstalación completada"
  yad --window-icon="$ICON_PATH" --title="$S3_TITLE" --image="dialog-information" \
    --text="Proceso de desinstalación finalizado.\nConsulte $LOG_FILE para detalles." \
    --button="Aceptar:0" 2>/dev/null || true
}

run_script_3() {
  while true; do
    ACTION=$(yad --window-icon="$ICON_PATH" --list --title="$S3_TITLE" --width=520 --height=350 \
      --column="Acción" --column="Descripción" \
      "1. $S3_REC" "Generar archivos en $TARGET_DIR" \
      "2. $S3_SEL (Instalar)" "Elegir paquetes para instalar" \
      "3. $S3_EXE (Instalar)" "Ejecutar la instalación" \
      "4. $S3_SEL (Desinstalar)" "Elegir paquetes para remover" \
      "5. $S3_EXE (Desinstalar)" "Ejecutar la desinstalación" \
      "6. $S3_BACK" "Regresar al menú principal" \
      --print-column=1 2>/dev/null || true)

    if [[ -z "$ACTION" ]]; then
      break
    fi

    case "$ACTION" in
      1.*) recopilar_listas ;;
      2.*)
        if [ "$DISTRO_FAMILY" = "arch" ]; then
          selector_paquetes "Pacman (Nativos)" "$NATIVE_LIST" "$NATIVE_SEL" "pacman"
          selector_paquetes "Yay (AUR)" "$AUR_LIST" "$AUR_SEL" "yay"
        else
          selector_paquetes "APT (Nativos)" "$NATIVE_LIST" "$NATIVE_SEL" "apt"
        fi
        selector_paquetes "Flatpak" "$FLATPAK_LIST" "$FLATPAK_SEL" "flatpak"
        ;;
      3.*) instalar_paquetes ;;
      4.*)
        if [ "$DISTRO_FAMILY" = "arch" ]; then
          selector_paquetes "Pacman Remove" "$NATIVE_LIST" "$NATIVE_RM_SEL" "pacman"
          selector_paquetes "Yay Remove" "$AUR_LIST" "$AUR_RM_SEL" "yay"
        else
          selector_paquetes "APT Remove" "$NATIVE_LIST" "$NATIVE_RM_SEL" "apt"
        fi
        selector_paquetes "Flatpak Remove" "$FLATPAK_LIST" "$FLATPAK_RM_SEL" "flatpak"
        ;;
      5.*) desinstalar_paquetes ;;
      6.*) break ;;
      *) break ;;
    esac
  done
}

# ------------------------------------------------------------------------------
# BUCLE PRINCIPAL
# ------------------------------------------------------------------------------
while true; do
  CHOICE=$(yad --window-icon="$ICON_PATH" --list --title="$TITLE_MAIN" \
    --text="$HEADER_TITLE" \
    --width=650 --height=430 --center \
    --column="Herramienta" --column="Descripción" \
    "$OPT_1_NAME" "$OPT_1_DESC" \
    "$OPT_2_NAME" "$OPT_2_DESC" \
    "$OPT_3_NAME" "$OPT_3_DESC" \
    "$OPT_EXIT" "$OPT_EXIT_DESC" \
    --separator="" 2>/dev/null || true)

  case "$CHOICE" in
    "$OPT_1_NAME"*) run_script_1 ;;
    "$OPT_2_NAME"*) run_script_2 ;;
    "$OPT_3_NAME"*) run_script_3 ;;
    *) exit 0 ;;
  esac
done
