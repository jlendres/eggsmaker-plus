else
  HEADER_TITLE="<span foreground='#3584e4' size='x-large'><b>Eggsmaker v$VERSION</b></span>\n<big>System Administration Suite ($DISTRO_FAMILY)</big>\n"
  TITLE_MAIN="Eggsmaker v$VERSION - System Tools"
  OPT_1_NAME="1. Generate ISO (Penguins Eggs)"
  OPT_1_DESC="Create a custom ISO image or system clone"
