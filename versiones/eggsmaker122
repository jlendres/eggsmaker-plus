# 1. Compatibilidad de Servidor Gráfico (Wayland / X11 / COSMIC / Sudo)
# ------------------------------------------------------------------------------
if [ -n "$SUDO_USER" ]; then
  REAL_UID=$(id -u "$SUDO_USER")
  REAL_HOME=$(eval echo ~"$SUDO_USER")

  export DISPLAY="${DISPLAY:-:0}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$REAL_UID}"
  export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

  # Credenciales de autorización de pantalla
  if [ -f "$REAL_HOME/.Xauthority" ]; then
    export XAUTHORITY="$REAL_HOME/.Xauthority"
  elif ls "$XDG_RUNTIME_DIR"/xauth_* &>/dev/null; then
    export XAUTHORITY=$(ls "$XDG_RUNTIME_DIR"/xauth_* 2>/dev/null | head -n 1)
  fi

  # Permitir conexión de root al servidor gráfico
  xhost +si:localuser:root &>/dev/null || true
fi

