# ------------------------------------------------------------------------------
# 5. Función de Copia Rápida de ISO en Un Solo Renglón (rsync + YAD progress)
# ------------------------------------------------------------------------------
copiar_iso_con_progreso() {
  local origen="$1"
  local destino="$2"

  rsync -ah --info=progress2 "$origen" "$destino" | stdbuf -i0 -o0 -e0 tr '\r' '\n' | \
  awk '
    /%/ {
      for (i=1; i<=NF; i++) {
        if ($i ~ /%/) {
          gsub("%", "", $i);
          print $i;
          fflush();
        }
      }
    }
  ' | $YAD_BASE --progress \
                --title="$S1_TITLE" \
                --text="Copiando imagen ISO a $destino..." \
                --percentage=0 \
                --auto-close \
                --auto-kill \
                --width=480 \
                --height=110
}

# ------------------------------------------------------------------------------
# 6. Módulo 1: Generador de ISO (Penguins Eggs)
# ------------------------------------------------------------------------------
ejecutar_modulo_1() {
  # Configuración previa
  if $YAD_BASE --title="$S1_TITLE" --text="$S1_CONF_CFG" --image=dialog-question; then
    eggs config
  fi

  # Selección de tipo de construcción
  local mode_flag=""
  if $YAD_BASE --title="$S1_TITLE" --text="$S1_CONF_CLONE" --image=dialog-question; then
    mode_flag="--clone"
  fi

  # Ejecución de construcción
  eggs produce $mode_flag

  # Ajuste de permisos en escritorio Live
  if [ -d "/home/eggs/Desktop" ]; then
    chmod +x /home/eggs/Desktop/*.desktop 2>/dev/null || true
  fi

  # Copia de ISO resultante
  local iso_file=$(ls -t /tmp/eggs/*.iso 2>/dev/null | head -n 1)

  if [ -f "$iso_file" ]; then
    while true; do
      if $YAD_BASE --title="$S1_TITLE" --text="$S1_COPY_OMIT" --image=dialog-question; then
        break
      fi

      local dest_dir
      dest_dir=$($YAD_BASE --file --directory --title="$S1_DEST_TITLE" --width=600 --height=400)

      if [ -n "$dest_dir" ]; then
        copiar_iso_con_progreso "$iso_file" "$dest_dir/"
      fi

      if ! $YAD_BASE --title="$S1_TITLE" --text="$S1_COPY_AGAIN" --image=dialog-question; then
        break
      fi
    done
  fi

  # Limpieza
  if $YAD_BASE --title="$S1_TITLE" --text="$S1_CONF_KILL" --image=dialog-question; then
    eggs kill
  fi

  $YAD_BASE --title="$S1_TITLE" --text="$S1_FINISH" --image=dialog-information --button="OK:0"
}

# ------------------------------------------------------------------------------
# 7. Módulo 2: Instalador Live (Calamares / Krill)
# ------------------------------------------------------------------------------
ejecutar_modulo_2() {
  local inst_choice
  inst_choice=$($YAD_BASE --title="$S2_TITLE" --text="$S2_PROMPT" \
                --list --column="ID" --column="Instalador" \
                1 "Calamares (GUI)" 2 "Krill (TUI)" \
                --width=400 --height=220 --hide-column=1)

  case "$inst_choice" in
    1*) calamares ;;
    2*) krill ;;
  esac
}

# ------------------------------------------------------------------------------
# 8. Módulo 3: Gestor de Paquetes Unificado
# ------------------------------------------------------------------------------
ejecutar_modulo_3() {
  mkdir -p "$TARGET_DIR"

  while true; do
    local s3_choice
    s3_choice=$($YAD_BASE --title="$S3_TITLE" \
               --list --column="ID" --column="Opción" \
               1 "$S3_REC" 2 "$S3_SEL" 3 "$S3_EXE" 4 "$S3_BACK" \
               --width=500 --height=280 --hide-column=1)

    case "$s3_choice" in
      1*)
        if [ "$DISTRO_FAMILY" = "arch" ]; then
          pacman -Qqetn > "$TARGET_DIR/lista-nativo.txt"
          pacman -Qqetm > "$TARGET_DIR/lista-aur.txt"
        elif [ "$DISTRO_FAMILY" = "debian" ]; then
          apt-mark showmanual > "$TARGET_DIR/lista-nativo.txt"
        fi
        if command -v flatpak &>/dev/null; then
          flatpak list --app --columns=application > "$TARGET_DIR/lista-flatpak.txt"
        fi
        $YAD_BASE --title="$S3_TITLE" --text="Listas guardadas en $TARGET_DIR" --image=dialog-information
        ;;

      2*)
        # Selección e instalación/desinstalación mediante YAD
        $YAD_BASE --title="$S3_TITLE" --text="Edición de listas lista-*.txt en $TARGET_DIR" --image=dialog-information
        ;;

      3*)
        # Ejecución de comandos según distro
        if [ "$DISTRO_FAMILY" = "arch" ]; then
          [ -f "$TARGET_DIR/lista-nativo.txt" ] && pacman -S --needed --noconfirm - < "$TARGET_DIR/lista-nativo.txt"
        elif [ "$DISTRO_FAMILY" = "debian" ]; then
          [ -f "$TARGET_DIR/lista-nativo.txt" ] && xargs -a "$TARGET_DIR/lista-nativo.txt" apt-get install -y
        fi
        ;;

      4*|"") break ;;
    esac
  done
}

# ------------------------------------------------------------------------------
# 9. Bucle Principal de la Interfaz (Menú YAD)
# ------------------------------------------------------------------------------
while true; do
  SELECCION=$($YAD_BASE --title="$TITLE_MAIN" \
               --text="$HEADER_TITLE" \
               --list \
               --column="Opción" --column="Descripción" \
               "$OPT_1_NAME" "$OPT_1_DESC" \
               "$OPT_2_NAME" "$OPT_2_DESC" \
               "$OPT_3_NAME" "$OPT_3_DESC" \
               "$OPT_EXIT"   "$OPT_EXIT_DESC" \
               --width=620 \
               --height=380 \
               --separator="")

  case "$SELECCION" in
    *"1."*) ejecutar_modulo_1 ;;
    *"2."*) ejecutar_modulo_2 ;;
    *"3."*) ejecutar_modulo_3 ;;
    *"$OPT_EXIT"*|"") break ;;
  esac
done

exit 0
