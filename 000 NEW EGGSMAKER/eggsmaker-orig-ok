log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

# ------------------------------------------------------------------------------
# MÓDULO 1: Generador de Imágenes ISO
# ------------------------------------------------------------------------------
run_script_1() {
  DST="/etc/penguins-eggs.d/scripts/trust-desktop.sh"
  mkdir -p "$(dirname "$DST")"
  cat << 'EOF' > "$DST"
#!/bin/bash
set -euo pipefail

# Asegurar permisos en la aplicación base del sistema
LAUNCHER_SYS="/usr/share/applications/install-system.desktop"
if [ -f "$LAUNCHER_SYS" ]; then
  chmod +x "$LAUNCHER_SYS"
fi

# Detectar escritorios de usuarios (incluyendo usuario live) y aplicar confianza
for desktop_dir in /home/*/[D|d]esktop /root/[D|d]esktop; do
  if [ -d "$desktop_dir" ]; then
    TARGET_LAUNCHER="$desktop_dir/install-system.desktop"

    if [ ! -f "$TARGET_LAUNCHER" ] && [ -f "$LAUNCHER_SYS" ]; then
      cp "$LAUNCHER_SYS" "$TARGET_LAUNCHER"
    fi

    if [ -f "$TARGET_LAUNCHER" ]; then
      chmod +x "$TARGET_LAUNCHER"

      if command -v gio >/dev/null 2>&1; then
        gio set "$TARGET_LAUNCHER" metadata::trusted yes 2>/dev/null || true
        if command -v sha256sum >/dev/null 2>&1; then
          gio set "$TARGET_LAUNCHER" metadata::xfce-exe-checksum "$(sha256sum "$TARGET_LAUNCHER" | awk '{print $1}')" 2>/dev/null || true
        fi
      fi
    fi
  fi
done

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f /usr/share/icons/* >/dev/null 2>&1 || true
fi
EOF
  chmod +x "$DST"

  ISO_DIR="/home/eggs"

  if yad --window-icon="$ICON_PATH" --image="dialog-question" --title="$S1_TITLE" --text="$S1_CONF_CFG" --button="Sí:0" --button="No:1"; then
    run_in_terminal "sudo eggs config"
  fi

  DO_CLONE=0
  if yad --window-icon="$ICON_PATH" --image="dialog-question" --title="$S1_TITLE" --text="$S1_CONF_CLONE" --button="Sí:0" --button="No:1"; then
    DO_CLONE=1
  fi

  if [[ $DO_CLONE -eq 1 ]]; then
    run_in_terminal "sudo eggs kill && sudo eggs tools clean && sudo eggs remaster --clone"
  else
    run_in_terminal "sudo eggs kill && sudo eggs tools clean && sudo eggs remaster"
  fi

  ISO_FILE=$(ls -t "$ISO_DIR"/*.iso 2>/dev/null | head -n 1 || true)

  while true; do
    DESTINO=$(yad --window-icon="$ICON_PATH" --file --directory --title="$S1_DEST_TITLE" 2>/dev/null || true)

    if [[ -z "$DESTINO" ]]; then
      if yad --window-icon="$ICON_PATH" --image="dialog-warning" --title="$S1_TITLE" --text="$S1_COPY_OMIT" --button="Sí:0" --button="No:1"; then
        break
      else
        continue
      fi
    fi

    if [[ -n "$ISO_FILE" ]]; then
      rsync --progress -h "$ISO_FILE" "$DESTINO/" | yad --window-icon="$ICON_PATH" --progress --title="Copiando ISO" --pulsate --auto-close
    else
      rsync --progress -ah "$ISO_DIR"/ "$DESTINO"/ | yad --window-icon="$ICON_PATH" --progress --title="Copiando Artefactos" --pulsate --auto-close
    fi

    if ! yad --window-icon="$ICON_PATH" --image="dialog-question" --title="$S1_TITLE" --text="$S1_COPY_AGAIN" --button="Sí:0" --button="No:1"; then
      break
    fi
  done

  if yad --window-icon="$ICON_PATH" --image="dialog-question" --title="$S1_TITLE" --text="$S1_CONF_KILL" --button="Sí:0" --button="No:1"; then
    eggs kill
  fi

  yad --window-icon="$ICON_PATH" --title="$S1_TITLE" --image="dialog-information" --text="$S1_FINISH" --button="Aceptar:0"
}

# ------------------------------------------------------------------------------
# MÓDULO 2: Instalador Live (Calamares / Krill)
# ------------------------------------------------------------------------------
run_script_2() {
  INSTALLER=$(yad --window-icon="$ICON_PATH" --list --radiolist --title="$S2_TITLE" --text="$S2_PROMPT" \
    --column="Sel" --column="Opción" --column="Comando" \
    TRUE "Calamares (GUI)" "sudo eggs sysinstall calamares" \
    FALSE "Krill (TUI)" "sudo eggs sysinstall krill" \
    --height=220 --width=480 --print-column=2 || true)

  if [[ -n "$INSTALLER" ]]; then
    if [[ "$INSTALLER" =~ "Calamares" ]]; then
      sudo eggs sysinstall calamares
    elif [[ "$INSTALLER" =~ "Krill" ]]; then
      run_in_terminal "sudo eggs sysinstall krill"
    fi
  fi
}

# ------------------------------------------------------------------------------
# MÓDULO 3: Gestor Unificado de Paquetes
# ------------------------------------------------------------------------------
recopilar_listas() {
  log_msg "Generando listas de paquetes en: $TARGET_DIR"
  rm -f "$PACMAN_LIST" "$YAY_LIST" "$FLATPAK_LIST"

  if command -v pacman &>/dev/null; then
    pacman -Qqetn | sort | grep -vwE '^(base|base-devel)$' > "$PACMAN_LIST" || true
    pacman -Qqetm | sort > "$YAY_LIST" || true
  fi

  if command -v flatpak &>/dev/null; then
    flatpak list --app --columns=application > "$FLATPAK_LIST" || true
  fi

  chown -R "$REAL_USER:" "$TARGET_DIR" 2>/dev/null || true

  pc_cnt=$(wc -l < "$PACMAN_LIST" 2>/dev/null || echo 0)
  yay_cnt=$(wc -l < "$YAY_LIST" 2>/dev/null || echo 0)
  fl_cnt=$(wc -l < "$FLATPAK_LIST" 2>/dev/null || echo 0)

  log_msg "Pacman: $pc_cnt | Yay: $yay_cnt | Flatpak: $fl_cnt"

  yad --window-icon="$ICON_PATH" --title="$S3_TITLE" \
    --image="dialog-information" \
    --text="Listas guardadas en:\n<b>$TARGET_DIR</b>\n\nPacman: $pc_cnt\nYay: $yay_cnt\nFlatpak: $fl_cnt" \
    --button="Aceptar:0"
}

selector_paquetes() {
  local titulo="$1" lista="$2" sel_prev="$3" tipo="$4"
  [[ -s "$lista" ]] || return 0

  local -a opciones=()
  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    local checked="FALSE"
    [[ -f "$sel_prev" ]] && grep -qxF "$pkg" "$sel_prev" && checked="TRUE"
    opciones+=("$checked" "$pkg" "$tipo")
  done < "$lista"

  local seleccion
  seleccion=$(yad --window-icon="$ICON_PATH" --list --checklist --title="$titulo" \
    --width=800 --height=500 --center \
    --column="CHK" --column="Paquete" --column="Tipo" \
    "${opciones[@]}" --print-column=2 --separator=$'\n' || true)

  if [[ -n "$seleccion" ]]; then
    echo "$seleccion" > "$sel_prev"
    chown "$REAL_USER:" "$sel_prev" 2>/dev/null || true
  fi
}

instalar_paquetes() {
  log_msg "Iniciando instalación desde $TARGET_DIR"
  [[ -s "$PACMAN_SEL" ]] && pacman -S --needed --noconfirm $(cat "$PACMAN_SEL")
  [[ -s "$YAY_SEL" ]] && command -v yay &>/dev/null && su - "$REAL_USER" -c "yay -S --needed --noconfirm $(cat "$YAY_SEL")"
  [[ -s "$FLATPAK_SEL" ]] && command -v flatpak &>/dev/null && flatpak install -y $(cat "$FLATPAK_SEL")

  log_msg "Instalación completada"
  yad --window-icon="$ICON_PATH" --title="$S3_TITLE" --image="dialog-information" \
    --text="Proceso de instalación completado.\nConsulte $LOG_FILE para detalles." \
    --button="Aceptar:0"
}

desinstalar_paquetes() {
  log_msg "Iniciando desinstalación desde $TARGET_DIR"
  [[ -s "$PACMAN_RM_SEL" ]] && pacman -Rns --noconfirm $(cat "$PACMAN_RM_SEL")
  [[ -s "$YAY_RM_SEL" ]] && command -v yay &>/dev/null && su - "$REAL_USER" -c "yay -Rns --noconfirm $(cat "$YAY_RM_SEL")"
  [[ -s "$FLATPAK_RM_SEL" ]] && command -v flatpak &>/dev/null && flatpak uninstall -y $(cat "$FLATPAK_RM_SEL")

  log_msg "Desinstalación completada"
  yad --window-icon="$ICON_PATH" --title="$S3_TITLE" --image="dialog-information" \
    --text="Proceso de desinstalación completado.\nConsulte $LOG_FILE para detalles." \
    --button="Aceptar:0"
}

run_script_3() {
  while true; do
    ACTION=$(yad --window-icon="$ICON_PATH" --list --title="$S3_TITLE" --width=520 --height=350 \
      --column="Acción" --column="Descripción" \
      "1. $S3_REC" "Generar archivos en $TARGET_DIR" \
      "2. $S3_SEL (Instalar)" "Elegir paquetes para instalar" \
      "3. $S3_EXE (Instalar)" "Ejecutar la instalación" \
      "4. $S3_SEL (Desinstalar)" "Elegir paquetes para remover" \
      "5. $S3_EXE (Desinstalar)" "Ejecutar la desinstalación" \
      "6. $S3_BACK" "Regresar al menú principal" \
      --print-column=1 || true)

    if [[ -z "$ACTION" ]]; then
      break
    fi

    case "$ACTION" in
      1.*) recopilar_listas ;;
      2.*)
        selector_paquetes "Pacman" "$PACMAN_LIST" "$PACMAN_SEL" "pacman"
        selector_paquetes "Yay" "$YAY_LIST" "$YAY_SEL" "yay"
        selector_paquetes "Flatpak" "$FLATPAK_LIST" "$FLATPAK_SEL" "flatpak"
        ;;
      3.*) instalar_paquetes ;;
      4.*)
        selector_paquetes "Pacman Remove" "$PACMAN_LIST" "$PACMAN_RM_SEL" "pacman"
        selector_paquetes "Yay Remove" "$YAY_LIST" "$YAY_RM_SEL" "yay"
        selector_paquetes "Flatpak Remove" "$FLATPAK_LIST" "$FLATPAK_RM_SEL" "flatpak"
        ;;
      5.*) desinstalar_paquetes ;;
      6.*) break ;;
      *) break ;;
    esac
  done
}

# ------------------------------------------------------------------------------
# BUCLE PRINCIPAL
# ------------------------------------------------------------------------------
while true; do
  CHOICE=$(yad --window-icon="$ICON_PATH" --list --title="$TITLE_MAIN" \
    --text="$HEADER_TITLE" \
    --width=650 --height=430 --center \
    --column="Herramienta" --column="Descripción" \
    "$OPT_1_NAME" "$OPT_1_DESC" \
    "$OPT_2_NAME" "$OPT_2_DESC" \
    "$OPT_3_NAME" "$OPT_3_DESC" \
    "$OPT_EXIT" "$OPT_EXIT_DESC" \
    --separator="" || true)

  case "$CHOICE" in
    "$OPT_1_NAME"*) run_script_1 ;;
    "$OPT_2_NAME"*) run_script_2 ;;
    "$OPT_3_NAME"*) run_script_3 ;;
    *) exit 0 ;;
  esac
done
